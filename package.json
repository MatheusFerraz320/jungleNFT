{
  "name": "junglenft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm router:generate && vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "router:generate": "tsr generate",
    "pretypecheck": "pnpm router:generate",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "msw:init": "msw init public --save",
    "figma:tokens": "node scripts/figma/extract-tokens.mjs",
    "figma:frames": "node scripts/figma/export-frames.mjs",
    "figma:artworks": "node scripts/figma/export-artworks.mjs",
    "lighthouse": "node lighthouse/run.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@hookform/resolvers": "7.0.9",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "axios": "1.15.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "0.563.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@mswjs/socket.io-binding": "0.2.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "5.108.4",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "chrome-launcher": "1.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lighthouse": "13.6.0",
    "msw": "2.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
